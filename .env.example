# TMDB credentials, used only by the server-side proxy (never sent to the browser).
# Get them at https://www.themoviedb.org/settings/api
# The read access token is preferred; the API key is a fallback.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# Set to "true" to use the built-in sample data instead of TMDB.
VITE_USE_MOCK_DATA=false
